 RowBox[{
  RowBox[{
   RowBox[{"BJ0", "[", 
    RowBox[{"m_", ",", "n_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"BJ0", "[", 
     RowBox[{"m", ",", "n"}], "]"}], "=", 
    RowBox[{"N", "@", 
     RowBox[{"BesselJZero", "[", 
      RowBox[{"m", ",", "n"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[Omega]", "[", 
