       RowBox[{"m", ",", "n"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"getFrame", "[", 
    RowBox[{"m_", ",", "n_", ",", "t_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", ",", "y"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Plot3D", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"A", " ", 
        RowBox[{"BesselJ", "[", 
         RowBox[{"m", ",", 
          RowBox[{
           FractionBox[
            SqrtBox[
             RowBox[{
              SuperscriptBox["x", "2"], "+", 
              SuperscriptBox["y", "2"]}]], "R"], 
           RowBox[{"BJ0", "[", 
            RowBox[{"m", ",", "n"}], "]"}]}]}], "]"}], " ", 
        RowBox[{"Re", "[", 
         SuperscriptBox[
          RowBox[{"(", 
           FractionBox[
            RowBox[{"x", "+", 
             RowBox[{"\[ImaginaryI]", " ", "y"}]}], 
            SqrtBox[
             RowBox[{
              SuperscriptBox["x", "2"], "+", 
              SuperscriptBox["y", "2"]}]]], ")"}], "m"], "]"}], 
        RowBox[{"Sin", "[", 
         RowBox[{
          RowBox[{"\[Omega]", "[", 
           RowBox[{"m", ",", "n"}], "]"}], " ", "t"}], "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", "y"}], "}"}], "\[Element]", " ", 
        RowBox[{"Disk", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "0"}], "}"}], ",", "R"}], "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"PlotRange", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "R"}], ",", "R"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "R"}], ",", "R"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "1.1"}], " ", "A"}], ",", 
            RowBox[{"1.1", " ", "A"}]}], "}"}]}], "}"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"SphericalRegion", "->", "True"}], ",", "\[IndentingNewLine]", 
       
       RowBox[{"Mesh", "->", "meshNum"}], ",", "\[IndentingNewLine]", 
       RowBox[{"BoxRatios", "->", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1", ",", "0.4"}], "}"}]}]}], 
      "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"makeGif", "[", 
     RowBox[{"m_", ",", "n_"}], "]"}], ":=", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"T", "=", " ", 
        FractionBox[
         RowBox[{"2", " ", "\[Pi]"}], 
         RowBox[{"\[Omega]", "[", 
          RowBox[{"m", ",", "n"}], "]"}]]}], " ", "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"frames", "=", 
        RowBox[{"ParallelTable", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"getFrame", "[", 
           RowBox[{"m", ",", "n", ",", "t"}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"t", ",", "0", ",", 
            RowBox[{"T", "-", 
             RowBox[{"T", "/", "totalFrames"}]}], ",", 
            RowBox[{"T", "/", "totalFrames"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"path", " ", "=", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{"saveDir", ",", 
           RowBox[{
            RowBox[{
            "StringTemplate", "[", "\"\<membrane_`1`_`2`.gif\>\"", "]"}], "[", 
            RowBox[{"m", ",", "n"}], "]"}]}], "}"}], "]"}]}], ";", "\n", 
       RowBox[{"Export", "[", 
        RowBox[{"path", ",", "frames", ",", 
         RowBox[{"\"\<AnimationRepetitions\>\"", "->", "Infinity"}], ",", 
         RowBox[{"\"\<DisplayDurations\>\"", "->", 
          RowBox[{"1", "/", "framesPerSecond"}]}]}], "]"}], ";", 
       "\[IndentingNewLine]", "path"}]}], "\[IndentingNewLine]", "]"}]}], 
